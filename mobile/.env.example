# Variáveis do app mobile. Copie para mobile/.env (que fica fora do git) e ajuste.
# As variáveis EXPO_PUBLIC_* entram no código do app na hora de empacotar: nunca ponha segredos
# aqui.

# Endereço da API, sempre pelo mesmo proxy do site (constituição, Princípio XII).
# Produção: https://contai-project.vercel.app
# API local pela rede de casa, só durante o desenvolvimento: http://<IP do PC>:8080
EXPO_PUBLIC_API_URL=https://contai-project.vercel.app

# Link do iCloud do atalho "Contaí" pronto para instalar (tarefa M6). Vazio até lá: o app mostra
# só o passo a passo manual.
EXPO_PUBLIC_SHORTCUT_URL=
