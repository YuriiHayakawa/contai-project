# Contaí — variáveis de ambiente.
# Copie este arquivo para ".env" e ajuste. O ".env" nunca vai para o repositório.
# Os valores abaixo servem só para desenvolvimento local; em produção, todo segredo
# precisa ser gerado de novo.

# --- Ambiente ---------------------------------------------------------------
# "development" ou "production". Scripts de desenvolvimento, como o de dados de
# demonstração, recusam-se a rodar em "production".
ENVIRONMENT=development

# --- Banco de dados ---------------------------------------------------------
# Usuário, senha e banco criados pelo contêiner do PostgreSQL.
POSTGRES_USER=contai
POSTGRES_PASSWORD=contai_dev
POSTGRES_DB=contai
# Porta em que o banco fica acessível na sua máquina (só em localhost), para rodar
# testes e ferramentas fora dos contêineres.
POSTGRES_HOST_PORT=5433
# Endereço do banco para a API e o worker ("postgres" é o nome do serviço no Compose).
DATABASE_URL=postgresql+asyncpg://contai:contai_dev@postgres:5432/contai
# Banco usado só pelos testes de integração. Para rodar os testes fora dos
# contêineres, troque "postgres:5432" por "localhost:5433".
TEST_DATABASE_URL=postgresql+asyncpg://contai:contai_dev@postgres:5432/contai_test

# --- Aplicação --------------------------------------------------------------
# Endereço público do app; usado nos links dos e-mails, no CORS e na checagem de Origin.
APP_ORIGIN=http://localhost:8080
# Origens extras liberadas no CORS, separadas por vírgula. Vazio: só a própria origem.
CORS_ALLOWED_ORIGINS=

# --- Segredos ---------------------------------------------------------------
# Assina os access tokens. Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-valor-em-producao-por-um-segredo-gerado
# Cifra o segredo da verificação em duas etapas. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# --- E-mail (SMTP) ----------------------------------------------------------
# Em desenvolvimento os e-mails vão para o Mailpit (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=Contaí <nao-responda@contai.local>

# --- Inteligência artificial -------------------------------------------------
# "fake" responde com dados roteirizados e não usa a rede; "gemini" usa o provedor real.
AI_PROVIDER=fake
# Chave do provedor de IA; necessária só com AI_PROVIDER=gemini.
AI_API_KEY=
# Modelo do chat, da sugestão de categorias e do lançamento por texto.
AI_MODEL_CHAT=
# Modelo da extração de PDF e imagem.
AI_MODEL_EXTRACTION=
# Modelos reserva (opcionais): quando o principal responde indisponível (503) ou sem cota
# (429), a chamada tenta o reserva antes de avisar o usuário.
AI_MODEL_CHAT_FALLBACK=
AI_MODEL_EXTRACTION_FALLBACK=
# Limites diários por usuário.
AI_DAILY_QUESTION_LIMIT=30
AI_DAILY_EXTRACTION_LIMIT=10

# --- Limites de frequência --------------------------------------------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_EMAIL_REQUESTS=5/hour
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_ASSISTANT=10/minute

# --- Uploads ----------------------------------------------------------------
# Tamanho máximo de um arquivo enviado, em bytes (10 MB).
UPLOAD_MAX_BYTES=10485760
# Diretório privado dos arquivos enviados; é um volume montado só na API e no worker.
UPLOAD_DIR=/data/uploads

# --- Backup (produção) ------------------------------------------------------
# Chave pública "age" que cifra os backups; a chave privada fica fora do servidor.
BACKUP_AGE_PUBLIC_KEY=
# Destino do rclone, no formato "remoto:bucket/pasta".
BACKUP_RCLONE_REMOTE=
# Dias que cada cópia é guardada.
BACKUP_RETENTION_DAYS=14
