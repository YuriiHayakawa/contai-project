# Servidor de arquivos da imagem de produção do frontend.
# O HTTPS e os cabeçalhos de segurança ficam no Caddy da frente (infra/Caddyfile).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode gzip
	# Rotas do app são resolvidas no navegador: tudo que não é arquivo cai no index.html.
	try_files {path} /index.html
	file_server
}
